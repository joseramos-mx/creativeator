# Copia este archivo como `.env.local` y pon tus llaves.
#
# `.env.local` está en .gitignore y no viaja con el repositorio: al clonar en
# otra máquina hay que crearlo a mano. Es a propósito — una llave en el
# historial de git no se borra cambiándola de sitio.

# Redactar y proponer temas. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Las fotos de ambiente. https://www.pexels.com/api/
PEXELS_API_KEY=

# Los íconos que la librería no tiene. Necesita facturación activada en el
# proyecto de Google. Sin esta llave el sistema no falla: los slides salen sin
# ícono y se ponen a mano.
GEMINI_API_KEY=

# ── Opcional: qué modelo escribe ────────────────────────────────────────────
# Sin estas líneas, redactar va con Opus 5 y lo auxiliar con Sonnet 5.
# Cambiar de versión dentro de Opus no baja el precio; cambiar de nivel sí.
# Antes de bajar el de redactar, lee la sección del README: lo que se arriesga
# no es una mentira publicada —la barrera no deja— sino más afirmaciones que
# revisar, y revisar ya es el cuello de botella.
# CLAUDE_MODELO=claude-sonnet-5
# CLAUDE_MODELO_AUXILIAR=claude-sonnet-5
